## COMMON
-debug 
-D fdb 
-cp src 
-lib msignal
--each 

## PRE-PROCESS
--next
-cmd haxelib install actuate --always || true
-cmd haxelib install msignal --always || true
-cmd haxelib install mloader --always || true
-cmd haxelib install pixijs --always || true
-cmd neko scripts/build-asset-maps.n -v
-cmd neko scripts/copy-html-template.n

## JS
--next
--macro include('neato.game.view')
--macro include('neato.poker.view')
-lib pixijs
-lib actuate
-lib msignal
-lib howlerjs
-main neato.template.GameEntry_template
-js bin/develop/hx-neato-core.js

## SWF
#--next
#-main neato.template.GameEntry_template
#-swf bin/develop/hx-neato-core.swf 
#-swf-header 1024:768:60:000000 
#-swf-version 12.0 